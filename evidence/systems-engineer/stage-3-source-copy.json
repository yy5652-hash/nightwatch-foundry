  "copy_python_source": "import datetime, hashlib, json, os, stat, subprocess, sys, time\nfrom pathlib import Path\nroot = Path.cwd().resolve()\nstart = datetime.datetime.now(datetime.timezone.utc).isoformat()\ntick = time.monotonic()\ncommands = []\ndef git(*args):\n    argv = [\"git\", *args]\n    p = subprocess.run(argv, cwd=root, capture_output=True, check=True)\n    commands.append({\"argv\": argv, \"exit_code\": p.returncode})\n    return p.stdout\ndef sha(data): return hashlib.sha256(data).hexdigest()\ndef check(stage, manifest_path):\n    manifest_bytes = (root / manifest_path).read_bytes()\n    manifest = json.loads(manifest_bytes)\n    rev = manifest[\"candidate_full_revision\"]\n    actual = {}\n    for line in git(\"ls-tree\", \"-r\", rev, f\"stage-{stage}\").decode().splitlines():\n        left, path = line.split(\"\\t\")\n        mode, kind, oid = left.split()\n        actual[path.removeprefix(f\"stage-{stage}/\")] = (mode, kind, oid)\n    assert set(actual) == {row[\"path\"] for row in manifest[\"tree\"]}\n    rows = []\n    for row in manifest[\"tree\"]:\n        name = row[\"path\"]\n        mode, kind, oid = actual[name]\n        assert mode == row[\"mode\"] and kind == \"blob\" and oid == row[\"object_id\"]\n        source = root / f\"stage-{stage}\" / name\n        assert source.is_file() and not source.is_symlink()\n        data = source.read_bytes()\n        blob = git(\"show\", f\"{rev}:stage-{stage}/{name}\")\n        fs_mode = stat.S_IMODE(source.stat().st_mode)\n        assert data == blob\n        assert bool(fs_mode & 0o111) == (mode == \"100755\")\n        rows.append({\"path\": name, \"git_mode\": mode, \"filesystem_mode\": oct(fs_mode), \"blob\": oid, \"sha256\": sha(data), \"bytes\": len(data), \"working_equals_accepted_blob\": True})\n    return {\"revision\": rev, \"manifest_path\": manifest_path, \"manifest_sha256\": sha(manifest_bytes), \"files\": rows}\nreport_path = root / \"evidence/systems-engineer/stage-3-source-copy.json\"\nassert not report_path.exists(), \"preserved report cannot be replaced\"\none = check(1, \"evidence/coordinator/accepted/stage-1-75005d57fe0904753eac4eab5bf4e4c9a78b6d1b.json\")\ntwo = check(2, \"evidence/coordinator/accepted/stage-2.json\")\nassert two[\"revision\"] == \"4dba10246b07b2dda19de260d529f9d94ba0a1ed\"\ncopied = []\nfor name in (\"core.py\", \"json_codec.py\"):\n    src, dst = root / \"stage-2\" / name, root / \"stage-3\" / name\n    data, mode = src.read_bytes(), stat.S_IMODE(src.stat().st_mode)\n    before = {\"exists\": dst.exists()}\n    if dst.exists():\n        assert dst.is_file() and not dst.is_symlink()\n        before.update({\"sha256\": sha(dst.read_bytes()), \"mode\": oct(stat.S_IMODE(dst.stat().st_mode))})\n        assert dst.read_bytes() == data, \"unexpected existing owned Stage 3 content\"\n    dst.parent.mkdir(exist_ok=True)\n    dst.write_bytes(data)\n    dst.chmod(mode)\n    assert dst.read_bytes() == data and stat.S_IMODE(dst.stat().st_mode) == mode\n    row = next(x for x in two[\"files\"] if x[\"path\"] == name)\n    copied.append({**row, \"source\": str(src), \"target\": str(dst), \"before\": before, \"byte_equal\": True, \"mode_equal\": True})\nassert check(1, one[\"manifest_path\"]) == one\nassert check(2, two[\"manifest_path\"]) == two\nend = datetime.datetime.now(datetime.timezone.utc).isoformat()\nreport = {\"package\": \"TK-20261004-S3-systems-engineer-INITIAL-1\", \"parts_received\": list(range(1,14)), \"end_received\": True, \"completeness_acknowledged_before_work\": True, \"final_part_receipt_message_id\": \"b77a7c04-8ece-40d2-961a-9249f5e0b1b3\", \"reciprocal_completeness_acknowledgement_message_id\": \"unknown\", \"scope\": \"Phase A Systems two-file byte/mode-exact copy only\", \"highest_consecutive_accepted_stage\": 2, \"stage3_accepted\": False, \"source_stage2\": two, \"frozen_stage1\": one, \"copied\": copied, \"frozen_source_folders_unchanged\": True, \"source_tree_stage2\": \"422380c814043021c2df2daad8edbbb34d5b5887\", \"coordinator_acceptance_commit\": \"a7ef75573233fbf4652b56d6609e14d82d21594c\", \"copy_commit\": None, \"implementation_release\": \"held pending coordinator complete nine-file proof and explicit release\", \"application_or_build_or_probe_execution\": False, \"commands\": commands, \"copy_python_source\": sys.argv[1], \"copy_invocation\": [\"../../.venv/bin/python\", \"-B\", \"-c\", \"<copy_python_source>\", \"<same source as argv[1]>\"], \"utc_start\": start, \"utc_end\": end, \"wall_seconds\": time.monotonic()-tick, \"harness\": \"Codex\", \"configured_model\": \"gpt-6.1-sol\", \"actual_model_override_effort_usage_catalog_estimated_billed_spend\": \"unknown\"}\nreport_path.write_text(json.dumps(report, indent=2) + \"\\n\")\nprint(json.dumps({\"copied\": [(x[\"path\"], x[\"sha256\"], x[\"filesystem_mode\"]) for x in copied], \"source_stage2_files_verified\": len(two[\"files\"]), \"source_stage1_files_verified\": len(one[\"files\"]), \"source_folders_unchanged\": True, \"wall_seconds\": report[\"wall_seconds\"]}))\n",
